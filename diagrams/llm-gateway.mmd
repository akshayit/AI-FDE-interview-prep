flowchart LR
  A["Client apps"] --> B["LLM gateway API"]
  B --> C["Auth and tenant limits"]
  C --> D{"Cache hit?"}
  D -- yes --> R["Return cached answer"]
  D -- no --> E["Model router"]
  E -- simple task --> F["Small model SLM"]
  E -- complex task --> G["Large model LLM"]
